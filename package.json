{
  "name": "dsh-memory-huixiang",
  "version": "0.1.1",
  "description": "回响（HuiXiang）：给 AI 一个记得住人的本地记忆库。纯文本外文库 + 记忆重量 + 因果链 + 触发词召回 + 自我笔记 + 人格底色/状态分离，冷记忆不占上下文。基于 cyber-hippocampus（赛博海马体）改造。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node demo/simulate.mjs",
    "eval": "node eval/run.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persona",
    "ai-companion",
    "huixiang"
  ],
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  }
}